NODE_ENV=development
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=3001
WEB_PORT=3000
WORKER_HEALTH_PORT=3002
DATABASE_URL=postgres://adp:adp@localhost:5432/adp_acquisition
OIDC_ISSUER_URL=https://login.microsoftonline.com/common/v2.0
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me
SESSION_SECRET=dev-only-change-me
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=adp-dev
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=dev
OBJECT_STORAGE_SECRET_ACCESS_KEY=dev
OTEL_SERVICE_NAME=adp-acquisition
RETENTION_EXPORT_HOURS=24
RETENTION_IMPORT_DAYS=30
RETENTION_LOG_DAYS=30
RETENTION_JOB_PAYLOAD_DAYS=30
RETENTION_BUSINESS_YEARS=7
RETENTION_AUDIT_YEARS=7
# Phase 1.2 research orchestration — live/archive network egress (default OFF).
# Do not set true without RB-015 owner approvals + source registry enablement.
ADP_LIVE_RESEARCH_ENABLED=false
ADP_RESEARCH_GLOBAL_KILL_SWITCH=false
# Job queue: omit/memory for local web deferred execute; durable requires postgres provider.
# ADP_JOB_QUEUE=durable
# ADP_RESEARCH_PROVIDER=memory

