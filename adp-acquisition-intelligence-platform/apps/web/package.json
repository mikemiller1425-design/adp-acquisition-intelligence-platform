{
  "name": "@adp/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke:health": "tsx src/smoke-health.ts",
    "test:e2e": "playwright test",
    "test:e2e:postgres": "pnpm --filter @adp/research build && playwright test --config=playwright.postgres.config.ts",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@adp/contracts": "workspace:*",
    "@adp/database": "workspace:*",
    "@adp/platform": "workspace:*",
    "@adp/reporting": "workspace:*",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@adp/research": "workspace:*",
    "@adp/collection": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
